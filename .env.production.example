# Copy to .env.production outside Git and replace every placeholder.
NODE_ENV=production
API_PORT=3000
LOG_LEVEL=info
SWAGGER_ENABLED=false
TRUST_PROXY=true
RELEASE_SHA=<GIT_COMMIT_SHA>
RELEASE_VERSION=0.8.0

# managed-tls is intended for managed PostgreSQL and Redis.
INFRASTRUCTURE_TRUST_MODE=managed-tls

POSTGRES_USER=fluxa
POSTGRES_PASSWORD=<GENERATE_A_LONG_RANDOM_PASSWORD>
POSTGRES_DB=fluxa
DATABASE_URL=postgresql://fluxa:<PASSWORD>@database.example.com:5432/fluxa
DATABASE_SSL=true
DATABASE_POOL_MAX=20

REDIS_HOST=cache.example.com
REDIS_PORT=6379
REDIS_PASSWORD=<GENERATE_A_LONG_RANDOM_PASSWORD>
REDIS_TLS=true

CORS_ORIGINS=https://app.example.com
BOOKING_WEB_BASE_URL=https://app.example.com

ACCESS_TOKEN_SECRET=<GENERATE_AT_LEAST_48_RANDOM_CHARACTERS>
REFRESH_TOKEN_SECRET=<GENERATE_A_DIFFERENT_RANDOM_SECRET>
SESSION_IP_HASH_SECRET=<GENERATE_A_DIFFERENT_RANDOM_SECRET>
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=fluxa-platform
JWT_AUDIENCE=fluxa-pos

STRIPE_ENABLED=true
STRIPE_SECRET_KEY=<STRIPE_LIVE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<STRIPE_LIVE_WEBHOOK_SECRET>

ACUBE_ENABLED=true
# Use either a bearer token or email/password, never commit real values.
ACUBE_BEARER_TOKEN=<ACUBE_PRODUCTION_TOKEN>
# ACUBE_EMAIL=<ACUBE_ACCOUNT_EMAIL>
# ACUBE_PASSWORD=<ACUBE_ACCOUNT_PASSWORD>
ACUBE_API_BASE_URL=https://api.acubeapi.com
ACUBE_AUTH_BASE_URL=https://common.api.acubeapi.com

# OpenAPI Smart Receipts. Keep real credentials outside Git.
OPENAPI_BEARER_TOKEN=<OPENAPI_PRODUCTION_TOKEN>
# Leave blank to use the official endpoint selected by the fiscal profile environment.
OPENAPI_API_BASE_URL=
