# Copy to .env.production outside Git and replace every placeholder.
NODE_ENV=production
API_PORT=3000
LOG_LEVEL=info
SWAGGER_ENABLED=false

POSTGRES_USER=fluxa
POSTGRES_PASSWORD=<GENERATE_A_LONG_RANDOM_PASSWORD>
POSTGRES_DB=fluxa
DATABASE_URL=postgresql://fluxa:<PASSWORD>@postgres:5432/fluxa
DATABASE_SSL=true
DATABASE_POOL_MAX=20

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<GENERATE_A_LONG_RANDOM_PASSWORD>

CORS_ORIGINS=https://pos.example.com
ACCESS_TOKEN_SECRET=<GENERATE_AT_LEAST_48_RANDOM_CHARACTERS>
REFRESH_TOKEN_SECRET=<GENERATE_A_DIFFERENT_RANDOM_SECRET>
SESSION_IP_HASH_SECRET=<GENERATE_A_DIFFERENT_RANDOM_SECRET>
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=fluxa-platform
JWT_AUDIENCE=fluxa-pos

# Use either a bearer token or email/password, never commit real values.
ACUBE_BEARER_TOKEN=<ACUBE_PRODUCTION_TOKEN>
# ACUBE_EMAIL=<ACUBE_ACCOUNT_EMAIL>
# ACUBE_PASSWORD=<ACUBE_ACCOUNT_PASSWORD>
ACUBE_API_BASE_URL=https://api.acubeapi.com
ACUBE_AUTH_BASE_URL=https://common.api.acubeapi.com
