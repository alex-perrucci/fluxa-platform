# Generated by scripts/vps/provision.sh as deploy/vps/.env.
NODE_ENV=production
API_PORT=3000
LOG_LEVEL=info
SWAGGER_ENABLED=false
TRUST_PROXY=true
RELEASE_SHA=0123456789abcdef0123456789abcdef01234567
RELEASE_VERSION=0.8.0

WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

POSTGRES_USER=fluxa
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_DB=fluxa
DATABASE_URL=postgresql://fluxa:replace-with-a-long-random-secret@postgres:5432/fluxa
DATABASE_SSL=false
DATABASE_POOL_MAX=20
INFRASTRUCTURE_TRUST_MODE=private-docker-network

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-long-random-secret
REDIS_TLS=false

CORS_ORIGINS=https://app.example.com
BOOKING_WEB_BASE_URL=https://app.example.com

ACCESS_TOKEN_SECRET=replace-with-at-least-48-random-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret
SESSION_IP_HASH_SECRET=replace-with-a-different-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=fluxa-platform
JWT_AUDIENCE=fluxa-pos

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
BOOTSTRAP_ADMIN_DISPLAY_NAME=Fluxa Admin

STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

ACUBE_ENABLED=false
ACUBE_BEARER_TOKEN=
ACUBE_EMAIL=
ACUBE_PASSWORD=
ACUBE_API_BASE_URL=https://api.acubeapi.com
ACUBE_AUTH_BASE_URL=https://common.api.acubeapi.com

# OpenAPI Smart Receipts. Keep both tokens only in the VPS environment.
# OPENAPI_BEARER_TOKEN is PRODUCTION-only; Sandbox has its own token.
OPENAPI_ENABLED=false
OPENAPI_BEARER_TOKEN=
OPENAPI_SANDBOX_BEARER_TOKEN=
# Leave blank for the official SANDBOX / PRODUCTION endpoint selected by the fiscal profile.
OPENAPI_API_BASE_URL=

# ADE_WEB Playwright runtime.
ADE_DRY_RUN_ENABLED=false
ADE_WORKER_INTERNAL_TOKEN=
ADE_WEB_ENTRY_URL=
# Public AdE entry URL used to begin the CIE login flow.
ADE_AUTH_ENTRY_URL=
# Read-only selector/config directory. Contains selectors.json and auth-profile.json.
ADE_RUNTIME_DIR=/opt/fluxa/runtime/ade
# Writable directory containing only storage-state.json.
ADE_SESSION_DIR=/opt/fluxa/runtime/ade-session
# Read-only directory containing cie-username and cie-password secret files.
ADE_SECRET_DIR=/opt/fluxa/runtime/ade-secrets
ADE_NAVIGATION_TIMEOUT_MS=20000
ADE_MFA_TIMEOUT_MS=180000

FLUXA_BACKUP_DIRECTORY=/var/backups/fluxa
FLUXA_BACKUP_RETENTION_DAYS=14
